--cpu Cortex-M3
"utm\startup_stm32f103xb.o"
"utm\main.o"
"utm\stm32f1xx_it.o"
"utm\stm32f1xx_hal_msp.o"
"utm\stm32f1xx_hal_gpio_ex.o"
"utm\stm32f1xx_hal_i2c.o"
"utm\stm32f1xx_hal.o"
"utm\stm32f1xx_hal_rcc.o"
"utm\stm32f1xx_hal_rcc_ex.o"
"utm\stm32f1xx_hal_gpio.o"
"utm\stm32f1xx_hal_dma.o"
"utm\stm32f1xx_hal_cortex.o"
"utm\stm32f1xx_hal_pwr.o"
"utm\stm32f1xx_hal_flash.o"
"utm\stm32f1xx_hal_flash_ex.o"
"utm\stm32f1xx_hal_exti.o"
"utm\stm32f1xx_hal_tim.o"
"utm\stm32f1xx_hal_tim_ex.o"
"utm\stm32f1xx_hal_uart.o"
"utm\system_stm32f1xx.o"
"utm\app.o"
"utm\hwio.o"
"utm\segger_rtt.o"
"utm\segger_rtt_printf.o"
--strict --scatter "UTM\UTM.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "UTM.map" -o UTM\UTM.axf